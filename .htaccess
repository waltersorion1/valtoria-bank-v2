Options -MultiViews
RewriteEngine On

# Resolve /page-name and /area/page-name to the matching PHP controller.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.+?)/?$ $1.php [L,QSA]

# Do not expose repository/configuration dotfiles through Apache.
<FilesMatch "^\.">
    Require all denied
</FilesMatch>
